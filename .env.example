# ==============================================================================
# TypeForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file or real secrets to Git.
# ==============================================================================

# Django Secret Key (required in production)
# In development, a safe default is used if left blank.
# On Render, this is automatically generated via render.yaml (generateValue: true).
# To generate manually: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-secure-random-50-character-secret-key

# Set to True for local development, False for production deployment
DEBUG=False

# Comma-separated list of hostnames/domains this Django app can serve
# In Render, .onrender.com and RENDER_EXTERNAL_HOSTNAME are automatically handled.
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,typeforge.ai,www.typeforge.ai

# Comma-separated list of trusted origins for Cross-Site Request Forgery (CSRF) protection
# Must include scheme (https:// or http://)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://typeforge.ai,https://www.typeforge.ai,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL database connection URL
# Format: postgres://username:password@hostname:port/database_name
# On Render: automatically linked from the PostgreSQL instance via render.yaml
# When DATABASE_URL is unset or empty, Django falls back to local SQLite (db.sqlite3).
# DATABASE_URL=postgres://typeforge_user:password@localhost:5432/typeforge

# SSL Redirect (enabled by default when DEBUG=False)
# Set to False only if testing production mode behind a local non-SSL proxy
SECURE_SSL_REDIRECT=True
